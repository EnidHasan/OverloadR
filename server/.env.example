# MongoDB Configuration
# IMPORTANT: Never commit actual credentials to Git!
# Option 1: MongoDB Atlas (Cloud) - Replace YOUR_USERNAME, YOUR_PASSWORD, and YOUR_CLUSTER with actual values
# If the Atlas hostname is invalid or unreachable in development, the server will
# fall back to local MongoDB and then to an in-memory MongoDB instance.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/workout-tracker?retryWrites=true&w=majority&appName=Cluster0

# Option 2: Local MongoDB (for development)
# MONGODB_URI=mongodb://127.0.0.1:27017/workout-tracker

# JWT Secret for authentication (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration (frontend)
VITE_API_URL=http://localhost:5000/api
